DATABASE_URL=postgresql://razorfy:razorfy@localhost:5432/razorfy
JWT_SECRET=local-development-secret-change-before-production-2026
JWT_CLIENT_EXPIRATION_HOURS=24
JWT_STAFF_EXPIRATION_HOURS=8
CASHBACK_RATE=0.1
PAYMENT_HOLD_MINUTES=10
BUSINESS_TIMEZONE=America/Sao_Paulo
CORS_ALLOWED_ORIGIN=http://localhost:5173
WHATSAPP_GATEWAY_URL=
NOTIFICATION_MAX_ATTEMPTS=5
DEV_BOOTSTRAP_ENABLED=false
DEV_ADMIN_EMAIL=admin@razorfy.local
DEV_ADMIN_PASSWORD=
DEV_STAFF_PASSWORD=
# Secret para os endpoints internos de jobs (/api/internal/jobs/*) acionados por cron externo.
# Obrigatório em produção serverless (Vercel); desnecessário rodando com `npm run dev` ou Docker.
CRON_SECRET=
# Login social Google (OAuth 2.0). Credenciais no Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI deve casar exatamente com GOOGLE_REDIRECT_URI (rota de callback do frontend).
# Deixe em branco para desabilitar o login com Google. NUNCA versione o client secret real.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
PORT=8080
