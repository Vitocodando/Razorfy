generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  phone     String?  @unique @db.VarChar(20)
  password  String?  @db.VarChar(255)
  googleId  String?  @unique @map("google_id") @db.VarChar(255)
  role      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  barberSlots                  BarberSlot[]
  clientAppointments           Appointment[]              @relation("ClientAppointments")
  barberAppointments           Appointment[]              @relation("BarberAppointments")
  cashbackWallet               CashbackWallet?
  appointmentStatusHistoryActs AppointmentStatusHistory[]
  scheduleBlocks               ScheduleBlock[]
  vacationBlocks               VacationBlock[]
  barberCommissions            BarberCommission[]
  reviewsAsBarber              Review[]                   @relation("BarberReviews")
  reviewsAsClient              Review[]                   @relation("ClientReviews")
  barberGoals                  BarberGoal[]
  clientNotes                  ClientNote[]               @relation("ClientNotes")
  authoredNotes                ClientNote[]               @relation("AuthoredNotes")

  @@map("users")
}

model BarberSlot {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId   String  @map("barber_id") @db.Uuid
  dayOfWeek  Int     @map("day_of_week")
  startTime  DateTime  @map("start_time") @db.Time(0)
  endTime    DateTime  @map("end_time") @db.Time(0)
  lunchStart DateTime? @map("lunch_start") @db.Time(0)
  lunchEnd   DateTime? @map("lunch_end") @db.Time(0)

  barber User @relation(fields: [barberId], references: [id])

  @@unique([barberId, dayOfWeek])
  @@map("barber_slots")
}

model Service {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String  @db.VarChar(50)
  durationMinutes Int     @map("duration_minutes")
  price           Decimal @db.Decimal(10, 2)
  active          Boolean @default(true)

  appointmentServices AppointmentService[]
  barberCommissions   BarberCommission[]

  @@map("services")
}

model Appointment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  barberId         String   @map("barber_id") @db.Uuid
  startTimestamp   DateTime @map("start_timestamp") @db.Timestamptz
  endTimestamp     DateTime @map("end_timestamp") @db.Timestamptz
  totalPrice       Decimal  @map("total_price") @db.Decimal(10, 2)
  cashbackUsed     Decimal  @default(0) @map("cashback_used") @db.Decimal(10, 2)
  couponId         String?  @map("coupon_id") @db.Uuid
  couponCode       String?  @map("coupon_code") @db.VarChar(20)
  couponDiscount   Decimal  @default(0) @map("coupon_discount") @db.Decimal(10, 2)
  amountPaid       Decimal  @map("amount_paid") @db.Decimal(10, 2)
  paymentMethod    String   @map("payment_method") @db.VarChar(20)
  status           String   @db.VarChar(30)
  paymentReference String?  @map("payment_reference") @db.VarChar(100)
  holdExpiresAt    DateTime? @map("hold_expires_at") @db.Timestamptz
  cashbackCredited Boolean  @default(false) @map("cashback_credited")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version          BigInt   @default(0)

  client User @relation("ClientAppointments", fields: [clientId], references: [id])
  barber User @relation("BarberAppointments", fields: [barberId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  services             AppointmentService[]
  statusHistory        AppointmentStatusHistory[]
  cashbackTransactions CashbackTransaction[]
  notificationOutbox   NotificationOutbox[]
  review               Review?
  adminAlerts          AdminAlert[]

  @@map("appointments")
}

model AppointmentService {
  appointmentId   String  @map("appointment_id") @db.Uuid
  serviceId       String  @map("service_id") @db.Uuid
  serviceName     String  @map("service_name") @db.VarChar(50)
  durationMinutes Int     @map("duration_minutes")
  price           Decimal @db.Decimal(10, 2)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

model CashbackWallet {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String  @unique @map("client_id") @db.Uuid
  balance         Decimal @default(0) @db.Decimal(10, 2)
  reservedBalance Decimal @default(0) @map("reserved_balance") @db.Decimal(10, 2)
  version         BigInt  @default(0)

  client       User                  @relation(fields: [clientId], references: [id])
  transactions CashbackTransaction[]

  @@map("cashback_wallets")
}

model CashbackTransaction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  appointmentId String?  @map("appointment_id") @db.Uuid
  type          String   @db.VarChar(20)
  amount        Decimal  @db.Decimal(10, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(10, 2)
  description   String   @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  wallet      CashbackWallet @relation(fields: [walletId], references: [id])
  appointment Appointment?   @relation(fields: [appointmentId], references: [id])

  @@map("cashback_transactions")
}

model Coupon {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar(20)
  discountType    String   @map("discount_type") @db.VarChar(15)
  discountValue   Decimal  @map("discount_value") @db.Decimal(10, 2)
  maxUsesGlobal   Int?     @map("max_uses_global")
  currentUses     Int      @default(0) @map("current_uses")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  appointments Appointment[]

  @@map("coupons")
}

model BarberCommission {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId      String   @map("barber_id") @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  commissionPct Decimal  @map("commission_pct") @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  barber  User    @relation(fields: [barberId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([barberId, serviceId])
  @@index([barberId])
  @@map("barber_commissions")
}

model VacationBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  barber User @relation(fields: [barberId], references: [id])

  @@index([barberId, startDate, endDate])
  @@map("vacation_blocks")
}

model AdminAlert {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String    @map("appointment_id") @db.Uuid
  alertType     String    @map("alert_type") @db.VarChar(20)
  status        String    @default("PENDING") @db.VarChar(15)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy    String?   @map("resolved_by") @db.Uuid

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([status, createdAt])
  @@map("admin_alerts")
}

model DailyAdminReport {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportDate           DateTime @unique @map("report_date") @db.Date
  grossRevenue         Decimal  @default(0) @map("gross_revenue") @db.Decimal(10, 2)
  netRevenue           Decimal  @default(0) @map("net_revenue") @db.Decimal(10, 2)
  concludedAppointments Int     @default(0) @map("concluded_appointments")
  noShowAppointments   Int      @default(0) @map("no_show_appointments")
  averageTicket        Decimal  @default(0) @map("average_ticket") @db.Decimal(10, 2)
  estimatedLtv         Decimal  @default(0) @map("estimated_ltv") @db.Decimal(10, 2)
  idleMinutes          Int      @default(0) @map("idle_minutes")
  occupancyPct         Decimal  @default(0) @map("occupancy_pct") @db.Decimal(5, 2)
  heatmap              Json     @default("[]")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("daily_admin_reports")
}

model AppointmentStatusHistory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  fromStatus    String?  @map("from_status") @db.VarChar(30)
  toStatus      String   @map("to_status") @db.VarChar(30)
  changedBy     String?  @map("changed_by") @db.Uuid
  payload       Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  actor       User?       @relation(fields: [changedBy], references: [id])

  @@map("appointment_status_history")
}

model NotificationOutbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String?   @map("appointment_id") @db.Uuid
  channel       String    @db.VarChar(20)
  destination   String    @db.VarChar(160)
  eventType     String    @map("event_type") @db.VarChar(50)
  payload       Json
  status        String    @default("PENDING") @db.VarChar(20)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  sentAt        DateTime? @map("sent_at") @db.Timestamptz
  lastError     String?   @map("last_error") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("notification_outbox")
}

// ----- Módulo Barbeiro & CRM (Fatia 1) -----

model ScheduleBlock {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId       String   @map("barber_id") @db.Uuid
  startTimestamp DateTime @map("start_timestamp") @db.Timestamptz
  endTimestamp   DateTime @map("end_timestamp") @db.Timestamptz
  reason         String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  barber User @relation(fields: [barberId], references: [id])

  @@index([barberId, startTimestamp])
  @@map("schedule_blocks")
}

model Review {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  barberId      String   @map("barber_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  rating        Int
  comment       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  barber      User        @relation("BarberReviews", fields: [barberId], references: [id])
  client      User        @relation("ClientReviews", fields: [clientId], references: [id])

  @@index([barberId])
  @@map("reviews")
}

model BarberGoal {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId           String   @map("barber_id") @db.Uuid
  periodStart        DateTime @map("period_start") @db.Date
  periodEnd          DateTime @map("period_end") @db.Date
  targetAppointments Int      @map("target_appointments")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  barber User @relation(fields: [barberId], references: [id])

  @@index([barberId])
  @@map("barber_goals")
}

model ClientNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  noteText  String   @map("note_text") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  client User @relation("ClientNotes", fields: [clientId], references: [id])
  author User @relation("AuthoredNotes", fields: [authorId], references: [id])

  @@index([clientId])
  @@map("client_notes")
}
